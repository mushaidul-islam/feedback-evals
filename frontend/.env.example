# Copy to .env.local. Read only by the Next.js server, never sent to the browser.

# From the OAuth 2.0 client (type "Web application") in Google Cloud Console.
# GOOGLE_CLIENT_ID must be the same value as GOOGLE_CLIENT_ID in backend/.env.
# The client secret is a password: never commit it, never prefix it NEXT_PUBLIC_.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The Go API, as seen from the Next.js server.
API_URL=http://localhost:8080
