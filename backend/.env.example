# Copy to .env. Every value below is the default the server already applies,
# so an empty .env still produces a working development server.
#
# The server does not read .env itself — configuration comes from the
# environment. `make dev` exports this file locally.

APP_ENV=development
HOST=0.0.0.0
PORT=8080

# debug | info | warn | error
LOG_LEVEL=info

# Comma-separated origins allowed to call the API from a browser.
CORS_ALLOWED_ORIGINS=http://localhost:3000

SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=30s

# Keep below your orchestrator's termination grace period (Kubernetes: 30s).
SERVER_SHUTDOWN_TIMEOUT=15s
