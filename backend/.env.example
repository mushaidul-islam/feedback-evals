# Copy to .env. Three values have no default and the server will not start
# without them: DATABASE_URL, BASETEN_API_KEY and GOOGLE_CLIENT_ID. Every
# other value below is the default the server already applies.
#
# The server does not read .env itself — configuration comes from the
# environment. `make dev` exports this file locally.

APP_ENV=development
HOST=0.0.0.0
PORT=8080
BASETEN_API_KEY=
BASETEN_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731

# debug | info | warn | error
LOG_LEVEL=info

# Comma-separated origins allowed to call the API from a browser.
CORS_ALLOWED_ORIGINS=http://localhost:3000

SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=30s

# Keep below your orchestrator's termination grace period (Kubernetes: 30s).
SERVER_SHUTDOWN_TIMEOUT=15s

# The one value with no default. The server refuses to start without it, so a
# misconfigured deployment fails loudly instead of talking to the wrong
# database. Matches the credentials in deploy/docker/docker-compose.yml.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/truthbetold?sslmode=disable

# Bring the schema in line with the models on startup. Set to false to stop
# the server touching the schema at all.
DB_AUTO_MIGRATE=true

# OAuth 2.0 Client ID (type "Web application") from Google Cloud Console.
# Must be the same value as GOOGLE_CLIENT_ID in frontend/.env.local: the server
# only accepts sign-ins that Google issued for this exact client. The client
# secret lives only in the frontend, which talks to Google.
GOOGLE_CLIENT_ID=
